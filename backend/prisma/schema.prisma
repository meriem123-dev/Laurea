generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN_STAFF
}

enum Speciality {
  RESEAUX_SEC
  DATA_SCIENCE
  GENIE_LOGICIEL
  INTELLIGENCE_ARTIFICIELLE
  SYSTEMES_INFORMATION
}

enum Cursus {
  MASTER
  INGENIEUR
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean              @default(true)
  updatedAt    DateTime             @updatedAt
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]
  student      Student?
  teacher      Teacher?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Student {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule     String        @unique
  speciality    Speciality
  group         String?
  cursus        Cursus
  accountStatus AccountStatus @default(PENDING)
}

model Teacher {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String? // "Pr." ou "Dr." (comme ProfessorTitle du front)
  specialty     String // texte libre, comme dans le front
  accountStatus AccountStatus @default(PENDING)
}

model Room {
  id        String @id @default(uuid())
  name      String @unique
  block     String @default("")
  pole      String @default("")
  equipment String @default("")
  capacity  Int
  tone      String @default("blue")
}