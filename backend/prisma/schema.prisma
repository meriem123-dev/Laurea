generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN_STAFF
}

enum Speciality {
  RESEAUX_SEC
  DATA_SCIENCE
  GENIE_LOGICIEL
  INTELLIGENCE_ARTIFICIELLE
  SYSTEMES_INFORMATION
}

enum Cursus {
  MASTER
  INGENIEUR
}

enum AccountStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TeamType {
  solo
  pair
  trio
  quad
}

enum ProjectStatus {
  deposited
  validated
  planned
  defended
  graded
  closed
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean              @default(true)
  updatedAt    DateTime             @updatedAt
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]
  student      Student?
  teacher      Teacher?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Student {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matricule     String        @unique
  speciality    Speciality
  group         String?
  cursus        Cursus
  accountStatus AccountStatus @default(PENDING)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Teacher {
  id            String        @id @default(uuid())
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String? // "Pr." ou "Dr." (comme ProfessorTitle du front)
  specialty     String // texte libre, comme dans le front
  accountStatus AccountStatus @default(PENDING)
  supervised   Project[] @relation("Supervisor")
  coSupervised Project[] @relation("CoSupervisor")
}

model Room {
  id        String @id @default(uuid())
  name      String @unique
  block     String @default("")
  pole      String @default("")
  equipment String @default("")
  capacity  Int
  tone      String @default("blue")
}

model Project {
  id              String        @id @default(uuid())
  title           String
  domain          Speciality
  company         String        @default("")
  academicYear    String
  teamType        TeamType
  supervisorId    String
  supervisor      Teacher       @relation("Supervisor", fields: [supervisorId], references: [id])
  coSupervisorId  String?
  coSupervisor    Teacher?      @relation("CoSupervisor", fields: [coSupervisorId], references: [id])
  notes           String        @default("")
  status          ProjectStatus @default(deposited)
  students        Student[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}